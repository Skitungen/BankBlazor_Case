<h3>CustomerProfile</h3>

@code {

}
@page "/customer/{CustomerId:int}"
@using BankBlazor.Client.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>Customer Profile</PageTitle>

<section class="container">
    <h2>Customer Dashboard</h2>

    @if (customer == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="info">
            <p><strong>Name:</strong> @customer.FirstName @customer.LastName</p>
            <p><strong>Email:</strong> @customer.EmailAddress</p>
            <p><strong>Phone:</strong> @customer.Telephonenumber</p>
            <p><strong>Address:</strong> @customer.Streetaddress, @customer.City, @customer.Country</p>
        </div>
    }
</section>

<section class="container">
    <h2>Accounts</h2>

    @if (accounts == null)
    {
        <p>Loading...</p>
    }
    else if (accounts.Count == 0)
    {
        <p>No accounts found for this customer.</p>
    }
    else
    {
        @foreach (var account in accounts)
        {
            <div class="account">
                <p><strong>Account Number:</strong> @account.AccountId</p>
                <p><strong>Type:</strong> @account.AccountType</p>
                <p><strong>Balance:</strong> @account.Balance.ToString("C")</p>

                <button @onclick="() => GoToTransactions(account.AccountId)">
                    View Transactions
                </button> View Transactions</button>
                <button @onclick="() => SelectAccount(account.AccountId)">
                    Deposit / Withdraw / Transfer
                </button>
            </div>
        }
    }
</section>

@if (selectedAccountId != null)
{
    <section class="container">
        <h2>Manage Account @selectedAccountId</h2>

        <div class="form-group">
            <label>Amount:</label>
            <input type="number" @bind="amount" step="0.01" />
        </div>

        <button @onclick="HandleDeposit">Deposit</button>
        <button @onclick="HandleWithdraw">Withdraw</button>

        <div class="form-group">
            <label>Transfer to Account ID:</label>
            <input type="number" @bind="transferToAccountId" />
        </div>
        <button @onclick="HandleTransfer">Transfer</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="alert">@message</p>
        }
    </section>
}

@code {
    [Parameter]
    public int CustomerId { get; set; }

    private CustomerDto? customer;
    private List<AccountDto>? accounts;
    private long? selectedAccountId;
    private decimal amount;
    private long? transferToAccountId;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        customer = await Http.GetFromJsonAsync<CustomerDto>($"api/Customer/{CustomerId}");
        accounts = await Http.GetFromJsonAsync<List<AccountDto>>($"api/Account/customer/{CustomerId}");
    }

    private void SelectAccount(long accountId)
    {
        selectedAccountId = accountId;
        message = string.Empty;
    }

    private async Task HandleDeposit()
    {
        var dto = new DepositWithdrawDto { AccountId = selectedAccountId!.Value, Amount = amount };
        var response = await Http.PostAsJsonAsync("api/Account/deposit", dto);

        if (response.IsSuccessStatusCode)
        {
            message = "Deposit successful!";
            await LoadData();
        }
        else
        {
            message = "Deposit failed: " + await response.Content.ReadAsStringAsync();
        }
    }

    private async Task HandleWithdraw()
    {
        var dto = new DepositWithdrawDto { AccountId = selectedAccountId!.Value, Amount = amount };
        var response = await Http.PostAsJsonAsync("api/Account/withdraw", dto);

        if (response.IsSuccessStatusCode)
        {
            message = "Withdrawal successful!";
            await LoadData();
        }
        else
        {
            message = "Withdrawal failed: " + await response.Content.ReadAsStringAsync();
        }
    }

    private async Task HandleTransfer()
    {
        if (transferToAccountId == null)
        {
            message = "Please enter a destination account ID.";
            return;
        }

        var dto = new TransferDto
        {
            FromAccountId = selectedAccountId!.Value,
            ToAccountId = transferToAccountId.Value,
            Amount = amount
        };

        var response = await Http.PostAsJsonAsync("api/Account/transfer", dto);

        if (response.IsSuccessStatusCode)
        {
            message = "Transfer successful!";
            await LoadData();
        }
        else
        {
            message = "Transfer failed: " + await response.Content.ReadAsStringAsync();
        }
    }
}